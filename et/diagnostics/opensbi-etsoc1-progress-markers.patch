 	if (rc)
 		sbi_hart_hang();
 
@@ -307,47 +310,47 @@ static void __noreturn init_coldboot(struct sbi_scratch *scratch, u32 hartid)
 			__stack_chk_guard = guard_val;
 	}
 
-	rc = sbi_trap_init(scratch, true);
+	mx_mark(0x15); rc = sbi_trap_init(scratch, true);
 	if (rc)
 		sbi_hart_hang();
 
-	rc = sbi_timer_init(scratch, true);
+	mx_mark(0x16); rc = sbi_timer_init(scratch, true);
 	if (rc)
 		sbi_hart_hang();
 
-	rc = sbi_platform_early_init(plat, true);
+	mx_mark(0x17); rc = sbi_platform_early_init(plat, true);
 	if (rc)
 		sbi_hart_hang();
 
-	rc = sbi_pmu_init(scratch, true);
+	mx_mark(0x18); rc = sbi_pmu_init(scratch, true);
 	if (rc) {
 		sbi_printf("%s: pmu init failed (error %d)\n",
 			   __func__, rc);
 		sbi_hart_hang();
 	}
 
-	rc = sbi_dbtr_init(scratch, true);
+	mx_mark(0x19); rc = sbi_dbtr_init(scratch, true);
 	if (rc)
 		sbi_hart_hang();
 
-	sbi_boot_print_banner(scratch);
+	mx_mark(0x1A); sbi_boot_print_banner(scratch);
 
 	sbi_double_trap_init(scratch);
 
